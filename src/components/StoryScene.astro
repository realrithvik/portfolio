---
const EMBERS = 18;
---

<!-- The scroll journey positions this light in the gap beside the content. -->
<div class="story-scene" aria-hidden="true">
  <svg class="story-scene__svg" viewBox="0 0 1000 1000" preserveAspectRatio="xMidYMid meet">
    <defs>
      <filter id="story-scene-comet" x="-100%" y="-100%" width="300%" height="300%">
        <feGaussianBlur stdDeviation="9" />
      </filter>
      <filter id="story-scene-bloom" x="-300%" y="-300%" width="700%" height="700%">
        <feGaussianBlur stdDeviation="10" />
      </filter>
    </defs>

    <g class="story-scene__comet" filter="url(#story-scene-comet)">
      {
        Array.from({ length: EMBERS }, (_, i) => (
          <circle class="story-scene__ember" data-ember={i} r="7" cx="0" cy="0" />
        ))
      }
    </g>

    <g class="story-scene__traveller">
      <circle class="story-scene__traveller-bloom" r="26" filter="url(#story-scene-bloom)" />
      <circle class="story-scene__traveller-dot" r="9" />
    </g>
  </svg>
</div>
