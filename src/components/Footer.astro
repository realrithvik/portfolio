---
import { getContact } from '../lib/content';

// The address itself lives only on /contact — the footer just points there, so it
// isn't sitting in the markup of every page for scrapers to find.
const { title } = await getContact();
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <p>© {new Date().getFullYear()} Rithvik A Koundinya</p>
    <p>
      <a href="/contact">{title}</a>
    </p>
  </div>
</footer>
