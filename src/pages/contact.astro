---
import PageLayout from '../layouts/PageLayout.astro';
---

<PageLayout title="Contact — Rithvik A Koundinya" description="Get in touch with Rithvik A Koundinya.">
  <section class="page-section container container--narrow">
    <h1 class="page-title">Say hello</h1>
    <p class="page-intro">
      Have a project in mind, or just want to chat about design? I'd love to hear from you.
    </p>

    <form class="contact-form" action="mailto:rithvik.koundinya@gmail.com" method="post" enctype="text/plain">
      <label>
        Your name
        <input type="text" name="name" required placeholder="What should I call you?" />
      </label>
      <label>
        Email
        <input type="email" name="email" required placeholder="you@example.com" />
      </label>
      <label>
        Message
        <textarea name="message" rows="5" required placeholder="Tell me what's on your mind..."></textarea>
      </label>
      <button type="submit" class="btn btn--accent">
        <span class="dot" aria-hidden="true"></span>
        Send message
      </button>
    </form>

    <p class="contact-aside">
      Or email directly: <a href="mailto:rithvik.koundinya@gmail.com">rithvik.koundinya@gmail.com</a>
    </p>
  </section>
</PageLayout>
