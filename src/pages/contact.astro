---
import PageLayout from '../layouts/PageLayout.astro';
import { getContact } from '../lib/content';

const contact = await getContact();
---

<PageLayout title="Contact — Rithvik A Koundinya" description="Get in touch with Rithvik A Koundinya.">
  <section class="page-section container container--narrow">
    <h1 class="page-title">{contact.title}</h1>
    <p class="page-intro">{contact.intro}</p>

    <div class="page-actions contact-actions">
      <a href={`mailto:${contact.email}`} class="btn btn--accent">{contact.emailLabel}</a>
      <a href={contact.linkedInUrl} class="btn">{contact.linkedInLabel}</a>
      <a href={contact.resumeUrl} class="btn">{contact.resumeLabel}</a>
    </div>
    <p class="contact-aside"><a href={`mailto:${contact.email}`}>{contact.email}</a></p>
  </section>
</PageLayout>
