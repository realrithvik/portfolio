---
import PageLayout from '../layouts/PageLayout.astro';
import { getAbout, paragraphs, renderInline } from '../lib/content';

const about = await getAbout();
---

<PageLayout title="About — Rithvik A Koundinya" description="About Rithvik A Koundinya and the dot.">
  <section class="page-section container container--narrow">
    <h1 class="page-title">{about.title}</h1>

    <div class="prose">
      {paragraphs(about.body).map((p) => <p set:html={renderInline(p)} />)}
    </div>

    <div class="page-actions">
      <a href="/contact" class="btn btn--accent">{about.ctaLabel}</a>
    </div>
  </section>
</PageLayout>
